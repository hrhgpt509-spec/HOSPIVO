<script>
  let toastTimer = null;
  function showToast(message) {
    const toast = document.getElementById('printNotification');
    const toastText = document.getElementById('notificationText');
    if (!toast || !toastText) return;
    
    toastText.textContent = message;
    toast.classList.remove('opacity-0');
    toast.classList.add('opacity-100');
    
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.remove('opacity-100');
      toast.classList.add('opacity-0');
    }, 3200);
  }

  function triggerPrint(labelType) {
    showToast(`${labelType} thermal printer par bhej diya gaya`);
  }

  function triggerScanLink() {
