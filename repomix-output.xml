<button class="h-16 px-space-xl rounded-xl bg-primary hover:bg-surface-tint text-on-primary shadow-xl flex items-center gap-space-md active:translate-y-0.5 transition-all" type="button">
<span class="material-symbols-outlined text-display-total leading-none">check_circle</span>
<div class="flex flex-col text-left">
<span class="font-button-text text-button-text text-on-primary leading-tight">Bill Pakka Karo</span>
<span class="font-label-sub-english text-label-sub-english text-primary-fixed leading-none">Confirm &amp; Print Bill</span>
</div>
</button>
</div>
</div>
<script>
  (function () {
    let currentInput = "200";
    const billTotal = 182;
    const cashInputEl = document.getElementById("cash-input");
    const changeTextEl = document.getElementById("change-text");
    const clearBtn = document.getElementById("btn-clear");
    const numBtns = document.querySelectorAll(".numpad-btn");

    function updateCalculations() {
      const val = parseInt(currentInput, 10) || 0;
      cashInputEl.textContent = "Rs. " + val;
      const change = val - billTotal;
      if (change >= 0) {
        changeTextEl.textContent = "Wapas do: Rs. " + change;
      } else {
        changeTextEl.textContent = "Baki hai: Rs. " + Math.abs(change);
      }
    }

    numBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const char = btn.textContent.trim();
        if (currentInput === "0" || currentInput === "200") {
          currentInput = char;
        } else {
          if (currentInput.length < 6) {
            currentInput += char;
          }
        }
        updateCalculations();
      });
    });

    clearBtn.addEventListener("click", () => {
      currentInput = "0";
      updateCalculations();
    });
  })();
</script></main></body></html>
