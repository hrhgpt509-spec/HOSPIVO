<script>
  (function() {
    const permBtn = document.getElementById('btn-permission');
    const folderBtn = document.getElementById('btn-change-folder');
    let granted = false;

    if (permBtn) {
      permBtn.addEventListener('click', function() {
        granted = !granted;
        if (granted) {
          permBtn.classList.remove('bg-primary', 'hover:bg-primary-container');
          permBtn.classList.add('bg-surface-variant', 'text-on-surface-variant');
          permBtn.innerHTML = `
            <span class="material-symbols-outlined text-headline-md text-primary" style="font-variation-settings: 'FILL' 1;">check_circle</span>
            <div class="flex flex-col text-left">
              <span class="font-title-hinglish text-title-hinglish text-primary leading-tight">Ijazat Mil Gayi</span>
              <span class="font-label-sub-english text-label-sub-english text-on-surface-variant leading-none">Permission Granted</span>
            </div>
          `;
        } else {
          permBtn.classList.add('bg-primary', 'hover:bg-primary-container');
          permBtn.classList.remove('bg-surface-variant', 'text-on-surface-variant');
          permBtn.innerHTML = `
            <span class="material-symbols-outlined text-headline-md" style="font-variation-settings: 'FILL' 1;">verified_user</span>
            <div class="flex flex-col text-left">
              <span class="font-title-hinglish text-title-hinglish leading-tight">Ijazat Do</span>
              <span class="font-label-sub-english text-label-sub-english text-primary-fixed leading-none">Allow Storage</span>
            </div>
          `;
        }
      });
    }

    if (folderBtn) {
      folderBtn.addEventListener('click', function() {
        const folderLabel = this.previousElementSibling.querySelector('.font-mono');
        if (folderLabel) {
          folderLabel.textContent = folderLabel.textContent.includes('D:\\') 
            ? 'C:\\Hospivo\\Daily_Backups' 
            : 'D:\\Hospivo_Store\\Secure_Backups';
        }
      });
    }
  })();
</script></main></div></div></body></html>
