<script>
  let currentTotal = 182;
  let itemCount = 4;

  function updateDisplay() {
    const totalEl = document.getElementById('grand-total-display');
    const countEl = document.getElementById('item-count-badge');
    if (totalEl) totalEl.innerText = 'Rs. ' + currentTotal;
    if (countEl) countEl.innerText = itemCount + ' items';
  }

  function addItem(name, price, unit) {
    const list = document.getElementById('bill-items-list');
    if (!list) return;

    const row = document.createElement('div');
    row.className = 'flex items-center justify-between p-space-xs bg-surface rounded-xl hover:bg-surface-container transition-colors animate-pulse';
    row.innerHTML = `
      <div class="flex flex-col">
        <span class="font-body-md text-body-md font-bold text-on-surface leading-snug">${name}</span>
        <span class="font-label-sub-english text-label-sub-english text-on-surface-variant">${unit}</span>
      </div>
      <div class="flex items-center gap-space-xs">
        <span class="font-body-md text-body-md font-extrabold text-on-surface">Rs. ${price}</span>
        <button onclick="removeItem(this, ${price})" class="text-on-surface-variant hover:text-error transition-colors p-1" title="Hatao">
          <span class="material-symbols-outlined text-[20px]">cancel</span>
        </button>
      </div>
    `;
    list.appendChild(row);
    currentTotal += price;
    itemCount += 1;
    updateDisplay();

    setTimeout(() => {
      row.classList.remove('animate-pulse');
    }, 400);

    list.scrollTop = list.scrollHeight;
  }

  function removeItem(buttonEl, price) {
    const row = buttonEl.closest('.flex.items-center.justify-between');
    if (row) {
      row.remove();
      currentTotal = Math.max(0, currentTotal - price);
      itemCount = Math.max(0, itemCount - 1);
      updateDisplay();
    }
  }

  function resetBill() {
    const list = document.getElementById('bill-items-list');
    if (list) list.innerHTML = '';
    currentTotal = 0;
    itemCount = 0;
    updateDisplay();
  }

  function executeCheckout() {
    const btn = document.getElementById('bill-banao-btn');
    if (!btn) return;
    const originalText = btn.innerHTML;
    btn.innerHTML = `
      <span class="material-symbols-outlined text-[30px] animate-spin text-white">progress_activity</span>
      <div class="flex flex-col items-start leading-none">
        <span class="font-title-hinglish text-title-hinglish font-bold text-white">Bill ban raha hai...</span>
        <span class="font-label-sub-english text-label-sub-english text-on-primary-container">Printing receipt</span>
      </div>
    `;
    setTimeout(() => {
      alert('Parcha safalta se ban gaya! (Bill printed: Rs. ' + currentTotal + ')');
      btn.innerHTML = originalText;
    }, 700);
  }
</script></main></body></html>
