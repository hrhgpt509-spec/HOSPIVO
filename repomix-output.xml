<script>
  let activeFilter = 'all';

  function filterStock(type, btn) {
    activeFilter = type;
    
    // Style all buttons
    const tabs = document.querySelectorAll('.filter-tab');
    tabs.forEach(tab => {
      tab.classList.remove('bg-primary', 'text-on-primary', 'shadow-md');
      tab.classList.add('bg-surface-container-lowest', 'text-on-surface');
      const badge = tab.querySelector('span.px-2\\.5');
      if (badge) {
        badge.classList.remove('bg-on-primary/20', 'text-on-primary');
        badge.classList.add('bg-surface-container');
      }
    });

    // Highlight active
    btn.classList.remove('bg-surface-container-lowest', 'text-on-surface');
    btn.classList.add('bg-primary', 'text-on-primary', 'shadow-md');
    const activeBadge = btn.querySelector('span.px-2\\.5');
    if (activeBadge) {
      activeBadge.classList.remove('bg-surface-container', 'text-tertiary', 'text-error');
      activeBadge.classList.add('bg-on-primary/20', 'text-on-primary');
    }

    applyFiltering();
  }

  function applyFiltering() {
    const searchVal = (document.getElementById('stockSearchInput').value || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.medicine-card');

    rows.forEach(row => {
      const name = (row.getAttribute('data-name') || '').toLowerCase();
      const status = row.getAttribute('data-status');

      let matchesFilter = true;
      if (activeFilter === 'low') {
        matchesFilter = (status === 'low');
      } else if (activeFilter === 'out') {
        matchesFilter = (status === 'out');
      }

      const matchesSearch = !searchVal || name.includes(searchVal);

      if (matchesFilter && matchesSearch) {
        row.style.display = 'flex';
      } else {
        row.style.display = 'none';
      }
    });
  }

  document.getElementById('stockSearchInput').addEventListener('input', applyFiltering);

  function selectMedicine(el, name, qty, rack) {
    const toast = document.getElementById('selectionToast');
    const toastName = document.getElementById('toastMedName');
    const toastRack = document.getElementById('toastRackInfo');

    toastName.textContent = name + ' (' + qty + ' pcs)';
    toastRack.textContent = 'Rack ' + rack + ' • Batch details loaded';

    toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
    toast.classList.add('opacity-100', 'translate-y-0');

    setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
    }, 2400);
  }
</script></main></body></html>
