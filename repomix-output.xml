                        <option key={pt.id || pt.name} value={pt.name}>
                          {pt.name}
                        </option>
                      ))}
                      {!BUILT_IN_PRODUCT_TYPES.includes(formData.form as BuiltInProductType) &&
                        !customProductTypes.some((pt) => pt.name === formData.form) &&
                        formData.form && (
