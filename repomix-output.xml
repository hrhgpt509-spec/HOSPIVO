<script>
  // Simple interaction for segmented selectors to demonstrate feedback within the single state
  document.querySelectorAll('.flex.items-center.gap-2.p-1.bg-surface-container').forEach(group => {
    const buttons = group.querySelectorAll('button');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Clear active styles from siblings
        buttons.forEach(b => {
          b.className = 'h-11 px-4 rounded-lg bg-transparent hover:bg-surface-container-high text-on-surface-variant font-label-sub-english text-label-sub-english font-medium flex items-center gap-1.5 transition-colors';
          const icon = b.querySelector('.material-symbols-outlined');
          if (icon) icon.remove();
        });
        // Apply active to clicked
        btn.className = 'h-11 px-4 rounded-lg bg-primary text-on-primary font-label-sub-english text-label-sub-english font-bold flex items-center gap-1.5 shadow-sm transition-transform active:translate-y-0.5';
        const checkIcon = document.createElement('span');
        checkIcon.className = 'material-symbols-outlined text-[18px]';
        checkIcon.innerText = 'check_circle';
        btn.prepend(checkIcon);
      });
    });
  });
