  it('detects missing name', () => {
    const invalidData: MedicineFormData = {
      ...DEFAULT_VALID_FORM,
      name: '   ',
    };
    const errors = validateMedicineForm(invalidData, SAMPLE_EXISTING_MEDICINES);
