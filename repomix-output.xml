<script>
  (function () {
    let currentInput = "200";
    const billTotal = 182;
    const cashInputEl = document.getElementById("cash-input");
    const changeTextEl = document.getElementById("change-text");
    const clearBtn = document.getElementById("btn-clear");
    const numBtns = document.querySelectorAll(".numpad-btn");

    function updateCalculations() {
      const val = parseInt(currentInput, 10) || 0;
      cashInputEl.textContent = "Rs. " + val;
      const change = val - billTotal;
      if (change >= 0) {
        changeTextEl.textContent = "Wapas do: Rs. " + change;
      } else {
        changeTextEl.textContent = "Baki hai: Rs. " + Math.abs(change);
      }
    }

    numBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const char = btn.textContent.trim();
        if (currentInput === "0" || currentInput === "200") {
          currentInput = char;
        } else {
          if (currentInput.length < 6) {
            currentInput += char;
          }
        }
        updateCalculations();
      });
    });

    clearBtn.addEventListener("click", () => {
      currentInput = "0";
      updateCalculations();
    });
  })();
</script></main></body></html>
