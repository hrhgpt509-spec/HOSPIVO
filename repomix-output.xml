<span class="material-symbols-outlined text-[24px]">arrow_back</span>
<div class="flex items-center gap-space-xs">
<span class="font-button-text text-button-text leading-none">Wapas</span>
<span class="font-label-sub-english text-label-sub-english text-on-surface-variant leading-none">(Back)</span>
</div>
</button>
