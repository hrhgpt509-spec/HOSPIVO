                <span className="text-error ml-1">*</span>
              </label>
              <input
                type="text"
                {...textFieldProps('name', newTypeName, (val) => {
                  setNewTypeName(val);
                  if (newTypeError) setNewTypeError('');
                })}
                placeholder={t('common.example', { example: t('medicine_form.type_name_example') })}
