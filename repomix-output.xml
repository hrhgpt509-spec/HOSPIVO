  // Ensure keyboard shortcuts respond smoothly on counter terminal
  document.addEventListener('keydown', function(e) {
    const qtyInput = document.getElementById('quantity-input');
    if (!qtyInput) return;

    if (e.key === 'Enter') {
      qtyInput.classList.add('ring-4', 'ring-primary');
      setTimeout(() => qtyInput.classList.remove('ring-4', 'ring-primary'), 200);
    } else if (e.key === 'ArrowLeft') {
      // Wapas indicator
      e.preventDefault();
    }
  });
