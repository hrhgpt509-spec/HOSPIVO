<script>
  // Simple micro-interactions for interactive filter tabs & sheet options without page jump
  document.querySelectorAll('.filter-tab').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll('.filter-tab').forEach(b => {
        b.className = 'filter-tab flex flex-col items-center justify-center min-h-[58px] py-1.5 px-space-xs bg-surface-container-low hover:bg-surface-container text-on-surface rounded-2xl transition-all shadow-sm active:translate-y-0.5';
        const icon = b.querySelector('.material-symbols-outlined');
        const hTitle = b.querySelector('.font-title-hinglish');
        const sTitle = b.querySelector('.font-label-sub-english');
        if (icon) icon.className = 'material-symbols-outlined text-[22px] text-on-surface';
        if (hTitle) hTitle.className = 'font-title-hinglish text-title-hinglish text-on-surface leading-tight';
        if (sTitle) sTitle.className = 'font-label-sub-english text-label-sub-english text-on-surface-variant leading-none';
      });
      button.className = 'filter-tab flex flex-col items-center justify-center min-h-[58px] py-1.5 px-space-xs bg-primary text-on-primary rounded-2xl transition-all shadow-md active:translate-y-0.5';
      const icon = button.querySelector('.material-symbols-outlined');
      const hTitle = button.querySelector('.font-title-hinglish');
      const sTitle = button.querySelector('.font-label-sub-english');
      if (icon) icon.className = 'material-symbols-outlined text-[22px] text-on-primary';
      if (hTitle) hTitle.className = 'font-title-hinglish text-title-hinglish text-on-primary leading-tight';
      if (sTitle) sTitle.className = 'font-label-sub-english text-label-sub-english text-primary-fixed leading-none';
    });
  });

  document.querySelectorAll('.sheet-opt').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll('.sheet-opt').forEach(b => {
        b.className = 'sheet-opt flex flex-col items-center justify-center p-space-xs bg-surface-container-low hover:bg-surface-container text-on-surface rounded-2xl shadow-sm transition-all active:translate-y-0.5';
        const num = b.querySelector('.font-headline-md');
        const lbl = b.querySelector('.font-label-sub-english');
        if (num) num.className = 'font-headline-md text-headline-md font-bold leading-tight text-on-surface';
        if (lbl) lbl.className = 'font-label-sub-english text-label-sub-english text-on-surface-variant leading-none mt-0.5';
      });
      button.className = 'sheet-opt flex flex-col items-center justify-center p-space-xs bg-primary text-on-primary rounded-2xl shadow-md transition-all active:translate-y-0.5';
      const num = button.querySelector('.font-headline-md');
      const lbl = button.querySelector('.font-label-sub-english');
      if (num) num.className = 'font-headline-md text-headline-md font-bold leading-tight text-on-primary';
      if (lbl) lbl.className = 'font-label-sub-english text-label-sub-english text-primary-fixed leading-none mt-0.5';
