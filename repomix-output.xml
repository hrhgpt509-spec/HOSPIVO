<script>
  (function () {
    let pin = "";
    const dots = document.querySelectorAll(".pin-dot");

    function renderDots() {
      dots.forEach((dot, index) => {
        if (index < pin.length) {
          dot.classList.remove("bg-surface-container-highest");
          dot.classList.add("bg-primary", "scale-110");
        } else {
          dot.classList.remove("bg-primary", "scale-110");
          dot.classList.add("bg-surface-container-highest");
        }
      });
    }

    function addDigit(digit) {
      if (pin.length < 6) {
        pin += digit;
        renderDots();
      }
    }

    function removeDigit() {
      if (pin.length > 0) {
        pin = pin.slice(0, -1);
        renderDots();
      }
    }

    document.querySelectorAll("[data-key]").forEach((btn) => {
      btn.addEventListener("click", () => {
        addDigit(btn.getAttribute("data-key"));
      });
    });

    const clearBtn = document.getElementById("btn-clear");
    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        removeDigit();
      });
    }

    const unlockBtn = document.getElementById("btn-unlock");
    if (unlockBtn) {
      unlockBtn.addEventListener("click", () => {
        if (pin.length === 6) {
          pin = "";
          renderDots();
        } else {
          const container = document.getElementById("pin-indicator-container");
          if (container) {
            container.classList.add("translate-x-2");
            setTimeout(() => container.classList.remove("translate-x-2"), 100);
          }
        }
      });
    }

    window.addEventListener("keydown", (e) => {
      if (/^[0-9]$/.test(e.key)) {
        addDigit(e.key);
      } else if (e.key === "Backspace") {
        removeDigit();
      } else if (e.key === "Enter") {
        if (unlockBtn) unlockBtn.click();
      }
    });
  })();
</script></main></body></html>
