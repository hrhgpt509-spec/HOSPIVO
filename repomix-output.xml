    const negativeMrp: MedicineFormData = {
      ...DEFAULT_VALID_FORM,
      mrpRupees: '-15.50',
    };
    const errorsNegative = validateMedicineForm(negativeMrp, SAMPLE_EXISTING_MEDICINES);
