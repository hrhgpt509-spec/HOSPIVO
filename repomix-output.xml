<script>
  let enteredPin = "";
  const maxDigits = 6;

  function updateDots() {
    const dots = document.querySelectorAll("#pin-indicator-group .pin-dot");
    dots.forEach((dot, index) => {
      if (index < enteredPin.length) {
        dot.classList.remove("bg-surface-container-lowest");
        dot.classList.add("bg-primary", "scale-110");
      } else {
        dot.classList.remove("bg-primary", "scale-110");
        dot.classList.add("bg-surface-container-lowest");
      }
    });
  }

  function handlePinInput(digit) {
    if (enteredPin.length < maxDigits) {
      enteredPin += digit;
      updateDots();
      if (enteredPin.length === maxDigits) {
        setTimeout(() => {
          enteredPin = "";
          updateDots();
        }, 600);
      }
    }
  }

  function handlePinBackspace() {
    if (enteredPin.length > 0) {
      enteredPin = enteredPin.slice(0, -1);
      updateDots();
    }
  }

  function handlePinClear() {
    enteredPin = "";
    updateDots();
  }

  document.addEventListener("keydown", (e) => {
    if (e.key >= "0" && e.key <= "9") {
      handlePinInput(e.key);
    } else if (e.key === "Backspace") {
      handlePinBackspace();
    } else if (e.key === "Escape") {
      handlePinClear();
    }
  });
</script></main></body></html>
